APP_NAME="Telegram Bot Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- База данных -----------------------------------------------------------
# OSPanel биндит модуль MySQL на собственный loopback-адрес, см. окно OSPanel.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telegram_bot_admin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Рассылки уходят в очередь, воркер: php artisan queue:work
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Telegram --------------------------------------------------------------
# Токен получают у @BotFather. В код токен не попадает никогда.
TELEGRAM_TOKEN=
# Имя бота без @ — используется только для ссылок в README и админке.
TELEGRAM_BOT_USERNAME=
# Произвольная строка: Telegram шлёт её в заголовке X-Telegram-Bot-Api-Secret-Token,
# webhook отклоняет запросы без неё. Сгенерировать: php artisan telegram:secret
TELEGRAM_WEBHOOK_SECRET=
# chat_id администраторов через запятую — им приходят уведомления о новых заявках.
TELEGRAM_ADMIN_CHAT_IDS=

VITE_APP_NAME="${APP_NAME}"

# --- Docker ---------------------------------------------------------------
# Пароли для контейнера MySQL из compose.yaml. К базе OSPanel отношения не имеют.
DOCKER_DB_PASSWORD=secret
DOCKER_DB_ROOT_PASSWORD=secret

# Учётка администратора, которую создаёт сидер при первом старте контейнера.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
