APP_NAME="Telegram Bot Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- База данных -----------------------------------------------------------
# OSPanel биндит модуль MySQL на собственный loopback-адрес, см. окно OSPanel.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telegram_bot_admin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Рассылки уходят в очередь, воркер: php artisan queue:work
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Telegram --------------------------------------------------------------
# Боты заводятся в админке (Настройки → Боты), токены хранятся там зашифрованными.
# Переменные ниже нужны только для первого бота при установке: db:seed
# создаст его из TELEGRAM_TOKEN, если в базе ещё нет ни одного бота.
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет webhook у каждого бота генерируется сам. Эта переменная нужна только
# при обновлении со старой версии с одним ботом — чтобы сохранить прежний секрет.
TELEGRAM_WEBHOOK_SECRET=
# chat_id администраторов через запятую — им приходят уведомления о новых заявках.
TELEGRAM_ADMIN_CHAT_IDS=
# Токен платёжного провайдера — теперь в карточке бота в админке. Отсюда
# он берётся только для первого бота при установке или обновлении.
TELEGRAM_PAYMENT_PROVIDER_TOKEN=
TELEGRAM_PAYMENT_CURRENCY=RUB
# Чек по 54-ФЗ через ЮKassa: включать, только если в ЮKassa подключена касса.
TELEGRAM_PAYMENT_RECEIPT=false
TELEGRAM_PAYMENT_VAT_CODE=1
# https-адрес сайта для Mini App: у каждого бота своя страница /app/{id}.
# Пусто — кнопка Mini App в ботах скрыта. Кнопку меню ставит php artisan telegram:menu-button
TELEGRAM_MINI_APP_URL=
# Сколько секунд действуют данные запуска Mini App (initData).
TELEGRAM_MINI_APP_AUTH_TTL=86400
# Docker, сервис bot: id бота для long polling. Пусто — первый активный.
BOT_ID=

VITE_APP_NAME="${APP_NAME}"

# --- Docker ---------------------------------------------------------------
# Пароли для контейнера MySQL из compose.yaml. К базе OSPanel отношения не имеют.
DOCKER_DB_PASSWORD=secret
DOCKER_DB_ROOT_PASSWORD=secret

# Учётка администратора, которую создаёт сидер при первом старте контейнера.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
